{
  "expo": {
    "name": "Helia",
    "slug": "helia-hotel-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "helia",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.mathtech.helia",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#19B56B" },
      "permissions": [],
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 96, "resizeMode": "contain", "backgroundColor": "#FFFFFF" }]
    ],
    "web": { "bundler": "metro", "favicon": "./assets/icon.png" }
  }
}

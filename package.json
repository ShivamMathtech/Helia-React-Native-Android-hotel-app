{
  "name": "helia-android",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "android:native": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:aab": "npx eas-cli@latest build --platform android --profile production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:web": "expo export --platform web --output-dir dist-web",
    "android:go": "expo start --android"
  },
  "dependencies": {
    "@expo-google-fonts/urbanist": "^0.4.1",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "^44.0.6",
    "expo-crypto": "~55.0.19",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "~19.2.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
